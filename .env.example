# Velvet Grill — environment variables
#
# Copy this file to .env.local and fill in the values.
# For local development, `npx supabase status` prints both values
# after the local stack is running.

# Supabase project URL (local stack default below).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable (anon) key. Server RPC calls intentionally use
# the publishable key + RLS — no service-role key belongs in this app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>

# Optional: canonical/OG base URL used for metadataBase, robots, and sitemap.
# Leave unset for local development (defaults to http://localhost:3000).
# Set it only when a production deployment is approved, and never point it
# at the Supabase API URL.
# NEXT_PUBLIC_SITE_URL=

# Server-only secret for signing short-lived password-recovery grants
# (src/lib/auth/recovery-session.ts). Generate with: openssl rand -hex 32
# Never expose it through NEXT_PUBLIC_* and never reuse a Supabase credential.
# A missing or too-short value fails closed and disables the reset flow
# entirely. Rotating it invalidates outstanding grants (at most 10 minutes
# old).
AUTH_RECOVERY_GRANT_SECRET=
